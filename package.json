{
  "name": "nanoclaw",
  "version": "2.1.53",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/index.js",
  "bin": {
    "ncl": "bin/ncl"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:auto": "tsx setup/auto.ts",
    "ncl": "tsx src/cli/client.ts",
    "chat": "tsx scripts/chat.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.29.0",
    "@chat-adapter/slack": "4.29.0",
    "@chat-adapter/telegram": "4.29.0",
    "@chat-adapter/whatsapp": "4.27.0",
    "@clack/core": "^1.2.0",
    "@clack/prompts": "^1.2.0",
    "@nanoco/nanoclaw-dashboard": "^0.3.0",
    "@onecli-sh/sdk": "2.2.1",
    "@slack/bolt": "^4.6.0",
    "@types/qrcode": "1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc12",
    "better-sqlite3": "11.10.0",
    "chat": "4.29.0",
    "cron-parser": "5.5.0",
    "discord.js": "^14.27.0",
    "googleapis": "^144.0.0",
    "grammy": "^1.39.3",
    "kleur": "^4.1.5",
    "openai": "^4.77.0",
    "pino": "9.6.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
